# Copy to .env.local (not committed) and adjust.

# Where the Go back-end is. Leave it empty to call /api on the site's own address: the dev server (and `vite preview`)
# forwards /api to API_PROXY_TARGET, and in production a reverse proxy does the same. Set it only when the back-end is
# on another address that allows this site (CORS), e.g. a tunnel.
VITE_API_URL=

# Development only: where the dev server forwards /api (the back-end's address, without /api).
API_PROXY_TARGET=http://localhost:8080

# Links in the sidebar and on the Office tour page (defaults are placeholders).
VITE_SLACK_URL=https://xsolla-school.slack.com
VITE_GITLAB_URL=https://gitlab.com/xsolla-school
VITE_OFFICE_TOUR_URL=https://example.com/office-tour
